<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	 xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package 
	  Name="SQLiteEditor" 
	  Manufacturer="tanno-seiichi" 
	  Version="3.0.2" 
	  ProductCode="*" 
	  UpgradeCode="{A02A0C9D-338C-4099-A7C4-CBE212191E50}"
	  Scope="perMachine">
	  
    <MajorUpgrade 
		DowngradeErrorMessage="!(loc.DowngradeError)" />

    <ui:WixUI Id="WixUI_MinimalUpgrade" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
	  
	  <Icon Id="ProductIcon" SourceFile="..\SQLiteEditor\Resources\SQLiteEditor.ico" />
	  <Property Id="ARPPRODUCTICON" Value="ProductIcon" />	  
    
    <!-- cabファイルを外部ファイルとして出力せず、.msiファイルに埋め込む -->
    <MediaTemplate EmbedCab="yes" />
    
    <Feature Id="Main">
      <ComponentGroupRef Id="SQLiteEditor" />
    </Feature>
  </Package>
</Wix>
